# Kopieren nach .env und Passwörter ändern (z. B. `openssl rand -base64 24`).
DB_PASS=bitte-aendern
DB_ROOT_PASS=bitte-auch-aendern

# Port im Heimnetz → http://<unraid-ip>:8085
KRITIS_PORT=8085
# Daten (Datenbank, Kacheln, Caches) liegen hier:
KRITIS_DATA=/mnt/user/appdata/kritis

# Image: aus GitHub Packages (öffentlich), oder lokal gebaut: kritis-lagekarte:latest
KRITIS_IMAGE=ghcr.io/allgrinder/mapping:latest

# Hinter HTTPS-Reverse-Proxy: true (dann auch TRUST_PROXY_HEADERS=true)
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Verwaltungsgrenzen beim ersten Start von Geobasis NRW laden (dl-de/zero-2.0)
AUTO_IMPORT_BOUNDARIES=true
# PLZ-Gebiete aus OpenStreetMap (ODbL, nicht amtlich) im Hintergrund laden, alle 30 Tage erneuern
AUTO_IMPORT_PLZ=true
PLZ_REFRESH_DAYS=30
# Topografische Karte: dtk = fehlende Kacheln beim DTK-WMS nachladen, none = nur lokaler Vorrat
TOPO_UPSTREAM=dtk
DTK_WMS_LAYERS=
